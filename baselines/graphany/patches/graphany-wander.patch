+def load_wander_bundle(bundle_dir, split_file="split.npz"):
+    """Load a Wander/GraphPFN-style npy bundle (features, targets, edgelist, split).
+
+    Empty ``features.npy`` (topology-only / nofeat) is replaced with a constant-1
+    column so LinearGNN channels still run. ``split_file`` selects a Wander
+    protocol split (``split.npz`` or ``split_{i}.npz``).
+    """
+    bundle_dir = Path(bundle_dir)
+    features = np.load(bundle_dir / "features.npy")
+    targets = np.load(bundle_dir / "targets.npy")
+    edgelist = np.load(bundle_dir / "edgelist.npy")
+    split_path = bundle_dir / split_file
+    if not split_path.is_file():
+        raise FileNotFoundError(f"Missing GraphAny split {split_path}")
+    split = np.load(split_path)
+    n_nodes = int(targets.shape[0])
+    if features.ndim != 2 or features.shape[1] == 0:
+        features = np.ones((n_nodes, 1), dtype=np.float32)
+    if edgelist.size == 0:
+        src = torch.zeros(0, dtype=torch.int64)
+        dst = torch.zeros(0, dtype=torch.int64)
+    else:
+        src = torch.as_tensor(edgelist[:, 0], dtype=torch.int64)
+        dst = torch.as_tensor(edgelist[:, 1], dtype=torch.int64)
+    g = dgl.graph((src, dst), num_nodes=n_nodes)
+    labels = torch.as_tensor(targets)
+    if labels.ndim > 1:
+        labels = labels.argmax(dim=-1)
+    labels = labels.long()
+    valid = labels >= 0
+    num_class = int(labels[valid].max().item()) + 1 if bool(valid.any()) else 1
+    labels = torch.where(labels < 0, torch.zeros_like(labels), labels)
+    feat = torch.as_tensor(features, dtype=torch.float32)
+    train_mask = torch.as_tensor(split["train"].astype(bool))
+    val_mask = torch.as_tensor(split["val"].astype(bool))
+    test_mask = torch.as_tensor(split["test"].astype(bool))
+    return g, labels, num_class, feat, train_mask, val_mask, test_mask
+
