+def symmetrize_train_csr(csr_mat):
+    """Binary CSR with (u, v) iff train has u->v or v->u (wander eval mask)."""
+    rev = csr_mat.transpose().tocsr()
+    sym = (csr_mat + rev).astype(np.float32)
+    sym.data = np.ones_like(sym.data, dtype=np.float32)
+    sym.eliminate_zeros()
+    return sym
